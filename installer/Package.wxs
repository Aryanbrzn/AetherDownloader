<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 package definition.
  Build after publishing the app to an absolute PublishDir, e.g.:

  wix build installer\Package.wxs ^
    -ext WixToolset.UI.wixext ^
    -d PublishDir=C:\path\to\publish\win-x64 ^
    -d Version=1.0.0 ^
    -d IconFile=C:\path\to\src\AetherDownloader.App\Assets\app.ico ^
    -arch x64 ^
    -o AetherDownloader-1.0.0-win-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="AetherDownloader"
           Language="1033"
           Version="$(Version)"
           Manufacturer="Aryanbrzn"
           UpgradeCode="A8E4B2C1-7D3F-4A91-9E6B-5C2D8F0A1B3E"
           Scope="perMachine">
    <SummaryInformation Description="Windows GUI for yt-dlp"
                        Manufacturer="Aryanbrzn" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AetherDownloader is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Aryanbrzn/AetherDownloader" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Aryanbrzn/AetherDownloader" />

    <Feature Id="MainFeature" Title="AetherDownloader" Level="1">
      <ComponentGroupRef Id="HarvestedAppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AetherDownloader" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AetherDownloader" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Package>

  <Fragment>
    <ComponentGroup Id="HarvestedAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="**\*.pdb" />
        <Exclude Files="**\*.xml" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut"
               Directory="ApplicationProgramsFolder"
               Guid="B1C2D3E4-F5A6-4789-8B0C-1D2E3F4A5B6C">
      <Shortcut Id="StartMenuShortcutLink"
                Name="AetherDownloader"
                Description="Windows GUI for yt-dlp"
                Target="[INSTALLFOLDER]AetherDownloader.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Aryanbrzn\AetherDownloader"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut"
               Directory="DesktopFolder"
               Guid="C2D3E4F5-A6B7-4890-9C1D-2E3F4A5B6C7D">
      <Shortcut Id="DesktopShortcutLink"
                Name="AetherDownloader"
                Description="Windows GUI for yt-dlp"
                Target="[INSTALLFOLDER]AetherDownloader.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\Aryanbrzn\AetherDownloader"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
