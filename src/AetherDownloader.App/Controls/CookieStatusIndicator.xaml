<UserControl x:Class="AetherDownloader.App.Controls.CookieStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AetherDownloader.Core.Models;assembly=AetherDownloader.Core"
             xmlns:converters="clr-namespace:AetherDownloader.App.Converters"
             Width="16"
             Height="16"
             Margin="0,0,8,0">
  <UserControl.Resources>
    <converters:CookieStatusToBrushConverter x:Key="StatusBrushConverter"/>
  </UserControl.Resources>
  <Grid VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot"
             Width="8"
             Height="8"
             Fill="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusBrushConverter}}">
      <Ellipse.Style>
        <Style TargetType="Ellipse">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="{x:Static models:CookieStatus.Valid}">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.6"
                                     To="1.0"
                                     Duration="0:0:0.3"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Ellipse.Style>
    </Ellipse>
  </Grid>
</UserControl>
