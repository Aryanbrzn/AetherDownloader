<UserControl x:Class="AetherDownloader.App.Controls.StepIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            CornerRadius="4"
            Padding="12,6"
            HorizontalAlignment="Stretch">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="Step 1 — Install"
                 Style="{StaticResource Caption}"
                 HorizontalAlignment="Center"/>
    </Border>

    <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center"
               Foreground="{StaticResource Brush.TextSecondary}"/>

    <Border Grid.Column="2"
            CornerRadius="4"
            Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="Step 2 — Login"
                 Style="{StaticResource Caption}"
                 HorizontalAlignment="Center"/>
    </Border>

    <TextBlock Grid.Column="3" Text="→" Margin="8,0" VerticalAlignment="Center"
               Foreground="{StaticResource Brush.TextSecondary}"/>

    <Border Grid.Column="4"
            CornerRadius="4"
            Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
              <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="Step 3 — Import"
                 Style="{StaticResource Caption}"
                 HorizontalAlignment="Center"/>
    </Border>
  </Grid>
</UserControl>
