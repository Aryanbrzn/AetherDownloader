<UserControl x:Class="AetherDownloader.App.Views.MetadataCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AetherDownloader.App.Controls"
             xmlns:converters="clr-namespace:AetherDownloader.App.Converters"
             xmlns:vm="clr-namespace:AetherDownloader.App.ViewModels">
  <UserControl.Resources>
    <converters:MetadataStateToVisibilityConverter x:Key="EmptyVisibility" TargetState="{x:Static vm:MetadataCardState.Empty}"/>
    <converters:MetadataStateToVisibilityConverter x:Key="LoadingVisibility" TargetState="{x:Static vm:MetadataCardState.Loading}"/>
    <converters:MetadataStateToVisibilityConverter x:Key="LoadedVisibility" TargetState="{x:Static vm:MetadataCardState.Loaded}"/>
    <converters:MetadataStateToVisibilityConverter x:Key="ErrorVisibility" TargetState="{x:Static vm:MetadataCardState.Error}"/>
    <converters:FormatOptionDisplayConverter x:Key="FormatDisplay"/>
  </UserControl.Resources>
  <Border Style="{StaticResource CardBorder}" MinHeight="200" Padding="16">
    <Grid>
      <controls:EmptyState Visibility="{Binding State, Converter={StaticResource EmptyVisibility}}"/>
      <controls:SkeletonLoader Visibility="{Binding State, Converter={StaticResource LoadingVisibility}}"/>

      <Grid Visibility="{Binding State, Converter={StaticResource LoadedVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="{Binding ThumbnailWidth}"
                Height="{Binding ThumbnailHeight}"
                Background="{StaticResource Brush.SurfaceAlt}"
                CornerRadius="4"
                Margin="0,0,16,0">
          <Grid>
            <Image Source="{Binding ThumbnailImage}"
                   Stretch="UniformToFill"/>
            <TextBlock Text="🎬"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.4">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ThumbnailImage}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}"
                     Style="{StaticResource TitleText}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{Binding MetadataSummary}"
                     Style="{StaticResource Caption}"
                     Margin="0,0,0,12"
                     TextWrapping="Wrap"/>
          <ComboBox Style="{StaticResource FormatComboBox}"
                    ItemsSource="{Binding FormatGroupsView}"
                    SelectedItem="{Binding SelectedFormat}"
                    IsEnabled="{Binding HasFormats}"
                    MinWidth="320">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource FormatDisplay}}"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                  </Style>
                </GroupStyle.ContainerStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Brush.SurfaceAlt}" Padding="8,6,8,4">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource Brush.TextSecondary}"/>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ComboBox.GroupStyle>
          </ComboBox>
        </StackPanel>
      </Grid>

      <StackPanel Visibility="{Binding State, Converter={StaticResource ErrorVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <TextBlock Text="⚠"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource Brush.Error}"
                   Margin="0,0,0,8"/>
        <TextBlock Text="{Binding ErrorMessage}"
                   Style="{StaticResource Body}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   MaxWidth="400"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
