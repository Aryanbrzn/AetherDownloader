<UserControl x:Class="AetherDownloader.App.Views.ZonePlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="48">
  <Border Style="{StaticResource CardBorder}"
          Padding="16"
          Margin="0,4">
    <TextBlock Text="{Binding ZoneName, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Style="{StaticResource Caption}"
               HorizontalAlignment="Center"
               Opacity="0.5"/>
  </Border>
</UserControl>
