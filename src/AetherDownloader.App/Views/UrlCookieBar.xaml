<UserControl x:Class="AetherDownloader.App.Views.UrlCookieBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:AetherDownloader.App.Controls"
             xmlns:behaviors="clr-namespace:AetherDownloader.App.Behaviors">
  <StackPanel>
    <Grid Height="44" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="🔗"
                 FontSize="16"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"/>

      <TextBox Grid.Column="1"
               Style="{StaticResource FluentTextBox}"
               ui:ControlHelper.PlaceholderText="e.g. https://archive.org/download/BigBuckBunny_328/BigBuckBunny_512kb.mp4"
               Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"/>

      <Button Grid.Column="2"
              Style="{StaticResource AccentButton}"
              Content="Inspect ▶"
              Command="{Binding InspectCommand}"
              MinWidth="100"
              Margin="8,0,0,0"/>
    </Grid>

    <Border x:Name="CookieStrip"
            behaviors:CookieDropBehavior.IsEnabled="True"
            behaviors:CookieDropBehavior.DropCommand="{Binding ImportCookieFileCommand}">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource CookieStripBorder}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding (behaviors:CookieDropBehavior.IsDragOver), RelativeSource={RelativeSource Self}}"
                         Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
              <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Text="🍪"
                     FontSize="14"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0"/>
          <controls:CookieStatusIndicator Status="{Binding CookieStatus}"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding CookieStatusText}"
                     Style="{StaticResource Body}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBlock Text="Drop cookies.txt here"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"
                     Opacity="0.7">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasCookieProfiles}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ComboBox ItemsSource="{Binding CookieProfiles}"
                    SelectedItem="{Binding ActiveCookieProfile}"
                    DisplayMemberPath="Name"
                    MinWidth="140">
            <ComboBox.Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasCookieProfiles}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
          </ComboBox>
        </StackPanel>

        <Button Grid.Column="2"
                Style="{StaticResource HyperlinkButton}"
                Content="? How to get cookies"
                Command="{Binding OpenCookieGuideCommand}"/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
