<Window x:Class="AetherDownloader.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="About AetherDownloader"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="AetherDownloader"
                 Style="{StaticResource TitleText}"
                 Margin="0,0,0,8"/>
      <TextBlock Text="Clean Windows GUI for yt-dlp"
                 Style="{StaticResource Body}"
                 Opacity="0.85"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Legal disclaimer"
                   Style="{StaticResource Body}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap"
                   Style="{StaticResource Caption}"
                   Margin="0,0,0,16"
                   Text="This software is an independent graphical user interface for yt-dlp. It is intended solely for personal archiving, educational use, and downloading public-domain or freely licensed (Creative Commons) content. The maintainers do not endorse copyright infringement or terms of service violations."/>

        <TextBlock Text="Third-party tools"
                   Style="{StaticResource Body}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap"
                   Style="{StaticResource Caption}"
                   Margin="0,0,0,8"
                   Text="yt-dlp (Unlicense) and FFmpeg (LGPL/GPL depending on build) are separate projects. This app does not redistribute their binaries in source control; they are resolved from PATH, Settings, or downloaded on demand into LocalAppData."/>

        <TextBlock TextWrapping="Wrap"
                   Style="{StaticResource Caption}"
                   Opacity="0.8"
                   Text="License: MIT — Copyright (c) 2026 Aryanbrzn. Source: https://github.com/Aryanbrzn/AetherDownloader"/>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2"
            Content="Close"
            Style="{StaticResource AccentButton}"
            HorizontalAlignment="Right"
            MinWidth="80"
            Click="OnCloseClick"/>
  </Grid>
</Window>
