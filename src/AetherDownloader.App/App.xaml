<Application x:Class="AetherDownloader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemeResources RequestedTheme="Dark"/>
        <ui:XamlControlsResources/>
        <ResourceDictionary Source="/AetherDownloader.App;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/AetherDownloader.App;component/Themes/Styles.xaml"/>
        <ResourceDictionary Source="/AetherDownloader.App;component/Themes/DarkOverrides.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
